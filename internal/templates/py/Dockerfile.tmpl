# syntax=docker/dockerfile:1

# Stage 1: Base - Python runtime & environment
FROM python:{{.RuntimeVersion}}-slim AS base

# Prevent python from writing .pyc files and enable unbuffered logging
ENV PYTHONDONTWRITEBYTECODE=1 \
  PYTHONUNBUFFERED=1 \
  PIP_DISABLE_PIP_VERSION_CHECK=1 \
  PATH="/app/.venv/bin:$PATH"

WORKDIR /app

# Tooling setup based on package manager
{{if eq .PackageManager "uv"}}
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv
ENV UV_LINK_MODE=copy
{{else if eq .PackageManager "poetry"}}
RUN pip install --no-cache-dir poetry \
  && poetry config virtualenvs.in-project true
{{end}}

# Stage 2: Builder - Install production dependencies into /app/.venv
FROM base AS builder

WORKDIR /app

# Create virtual environment
RUN python -m venv /app/.venv

# Copy dependency specifications first to leverage caching
{{if eq .PackageManager "uv"}}
COPY pyproject.toml uv.lock* ./
RUN --mount=type=cache,target=/root/.cache/uv \
  uv sync --frozen --no-install-project --no-dev
{{else if eq .PackageManager "poetry"}}
COPY pyproject.toml poetry.lock* ./
RUN --mount=type=cache,target=/root/.cache/pypoetry \
  poetry install --no-root --without dev
{{else}}
COPY requirements.txt ./
RUN --mount=type=cache,target=/root/.cache/pip \
  /app/.venv/bin/pip install -r requirements.txt
{{end}}

# Stage 3: Development - Hot-reload
FROM builder AS dev

WORKDIR /app

# Install dev dependencies if applicable
{{if eq .PackageManager "uv"}}
RUN --mount=type=cache,target=/root/.cache/uv \
  uv sync --frozen --no-install-project
{{else if eq .PackageManager "poetry"}}
RUN --mount=type=cache,target=/root/.cache/pypoetry \
  poetry install --no-root
{{end}}

COPY . .

ENV PORT={{.Port}}
EXPOSE {{.Port}}

{{if eq .Framework "fastapi"}}
CMD ["uvicorn", "main:app", "--reload", "--host", "0.0.0.0", "--port", "{{.Port}}"]
{{else}}
CMD ["python", "main.py"]
{{end}}

# Stage 4: Production - Minimal, unprivileged runtime
FROM python:{{.RuntimeVersion}}-slim AS prod

# Create a non-privileged user and group (UID 10001)
RUN groupadd -g 10001 appgroup && \
  useradd -u 10001 -g appgroup -s /bin/sh -d /app appuser

WORKDIR /app

# Set environment variables for production runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
  PYTHONUNBUFFERED=1 \
  PATH="/app/.venv/bin:$PATH"

# Copy application source code
COPY --chown=appuser:appgroup . .
# Copy virtual environment from builder stage with proper ownership
COPY --chown=appuser:appgroup --from=builder /app/.venv /app/.venv

USER appuser

ENV PORT={{.Port}}
EXPOSE {{.Port}}

{{if eq .Framework "fastapi"}}
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "{{.Port}}"]
{{else}}
CMD ["python", "main.py"]
{{end}}
