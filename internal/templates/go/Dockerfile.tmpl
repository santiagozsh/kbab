# syntax=docker/dockerfile:1

# Stage 1: Base - Go environment & dependencies
FROM golang:{{.RuntimeVersion}}-alpine AS base

WORKDIR /app

# Copy dependency definitions
COPY go.mod go.sum* ./

# Download dependencies using BuildKit cache mount
RUN --mount=type=cache,target=/go/pkg/mod \
  go mod download

# Stage 2: Development - Hot-reload with Air

FROM base AS dev

# Install git and air for live reloading
RUN apk add --no-cache git \
  && go install github.com/air-verse/air@latest

# Fallback copy of source code (in dev this is usually mounted as a volume)
COPY . .

ENV PORT={{.Port}}
EXPOSE {{.Port}}

CMD [ "air", "-c", ".air.toml"  ]

# Stage 3: Builder - Compile statically linked binary

FROM base AS builder

# Copy all source code for compilation
COPY . .

# Build with optimizations and compiler cache mounts
RUN --mount=type=cache,target=/go/pkg/mod \
  --mount=type=cache,target=/root/.cache/go-build \
  CGO_ENABLED=0 GOOS=linux go build \
  -ldflags="-s -w" \
  -o /app/server .

# Stage 4: Production - Minimal and secure Distroless image

FROM gcr.io/distroless/static-debian13:nonroot AS prod

WORKDIR /

# Copy the compiled binary from the builder stage
COPY --from=builder /app/server /server

# Use nonroot unprivileged user (UID 65532)
USER nonroot:nonroot

ENV PORT={{.Port}}
EXPOSE {{.Port}}

ENTRYPOINT [ "/server" ]
